{
  "description": "specs/*/decisions.md가 있는 프로젝트에서 SDD 규칙을 주입하고, 진행 중인 스펙 없이 코드를 고치면 경고한다.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "python3 -I \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/sdd_hook.py\" || true", "timeout": 20 }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          { "type": "command", "command": "python3 -I \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/sdd_hook.py\" || true", "timeout": 10 }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|NotebookEdit",
        "hooks": [
          { "type": "command", "command": "python3 -I \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/sdd_hook.py\" || true", "timeout": 10 }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "python3 -I \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/sdd_hook.py\" || true", "timeout": 20 }
        ]
      }
    ]
  }
}
